<%- include('partials/head') %><section class="phero"><div class="wrap"><h1>Gallery.</h1><p class="lead">Carton and packaging visuals.</p></div></section>
<section class="sec"><div class="wrap"><p class="fine dk">Notice: the visuals below are illustrative studio renders, not photographs of company work. Grey placeholders mark where real photographs will be added.</p><div class="filters"><button class="on" data-f="all">All</button><% content.galleryCats.forEach(c=>{ %><button data-f="<%= c %>"><%= c %></button><% }) %></div>
<div class="masonry"><% content.gallery.forEach(([cat,src,alt,shape])=>{ %><figure class="mi <%= shape %>" data-cat="<%= cat %>"><% if (src) { %><img src="/images/mockups/<%= src %>.webp" alt="<%= alt %> - illustrative render" loading="lazy" width="1200" height="900"><span class="badge">Illustrative</span><% } else { %><img src="/placeholder/<%= encodeURIComponent(alt) %>.svg" alt="<%= alt %>" loading="lazy" width="400" height="300"><% } %><figcaption><%= cat %></figcaption></figure><% }) %></div></div></section><%- include('partials/custom-cta') %><%- include('partials/foot') %>
