<%- include('partials/head') %><section class="phero"><div class="wrap"><h1>Request a quote.</h1><p class="lead">Share your requirements, reference sample, drawing or idea. Our team will review them and get in touch.</p></div></section>
<section class="sec"><div class="wrap qwrap"><div class="qmain"><p class="note strong">Submitting this form is a quotation enquiry, not a confirmed order. Our team will review your requirements and contact you for further discussion.</p><% const v=(k)=>form[k]||''; const E=(k)=>errors&&errors[k]?`<span class="err">${errors[k]}</span>`:''; const opts=content.products.map(p=>p.name).concat(['Other / Custom Packaging']); const sel=(o)=>(v('product_type')===o||content.products.find(p=>p.slug===v('product_type')&&p.name===o))?'selected':''; %>
<form method="post" action="/quote" enctype="multipart/form-data" novalidate><input type="hidden" name="_csrf" value="<%= csrf %>">
<fieldset><legend>Customer information</legend>
<label>Company name *<input name="company_name" required value="<%= v('company_name') %>"><%- E('company_name') %></label>
<label>Contact person *<input name="contact_person" required value="<%= v('contact_person') %>"><%- E('contact_person') %></label>
<label>Phone number *<input name="phone" required value="<%= v('phone') %>"><%- E('phone') %></label><label>WhatsApp number<input name="whatsapp" value="<%= v('whatsapp') %>"></label>
<label>Email (optional)<input type="email" name="email" value="<%= v('email') %>"><%- E('email') %></label><label>City *<input name="city" required value="<%= v('city') %>"><%- E('city') %></label><label>Address (optional)<input name="address" value="<%= v('address') %>"></label></fieldset>
<fieldset><legend>Packaging requirements</legend>
<label>Product type *<select name="product_type" required><option value="">Select...</option><% opts.forEach(o=>{ %><option <%= sel(o) %>><%= o %></option><% }) %></select><%- E('product_type') %></label>
<div class="dims"><label>Length<input name="length" inputmode="decimal" value="<%= v('length') %>"></label><label>Width<input name="width" inputmode="decimal" value="<%= v('width') %>"></label><label>Height<input name="height" inputmode="decimal" value="<%= v('height') %>"></label><label>Unit<select name="unit"><% ['inch','cm','mm'].forEach(u=>{ %><option <%= v('unit')===u?'selected':'' %>><%= u %></option><% }) %></select></label></div>
<label>Material / ply (if known)<input name="material_ply" value="<%= v('material_ply') %>"></label><label>Printing requirements<input name="printing" value="<%= v('printing') %>"></label><label>Number of printing colours (if known)<input name="print_colours" value="<%= v('print_colours') %>"></label>
<label>Partition / window / handle / other<input name="custom_requirements" value="<%= v('custom_requirements') %>"></label><label>Requested quantity<input name="quantity" value="<%= v('quantity') %>"></label><label>Required delivery timeline<input name="timeline" value="<%= v('timeline') %>"></label></fieldset>
<fieldset><legend>Attachments</legend><label>Reference photos, artwork or drawings (JPG, PNG, WEBP, PDF; up to 5 files, 10 MB each)<input type="file" name="attachments" multiple accept=".jpg,.jpeg,.png,.webp,.pdf"><%- E('attachments') %></label></fieldset>
<fieldset><legend>Additional</legend><label>Describe your requirements<textarea name="description" rows="5" maxlength="3000"><%= v('description') %></textarea><%- E('description') %></label>
<label>Preferred contact method<select name="contact_method"><% ['WhatsApp','Phone','Email'].forEach(c=>{ %><option <%= v('contact_method')===c?'selected':'' %>><%= c %></option><% }) %></select></label></fieldset>
<p class="note">Prices are not calculated automatically. The quantity you enter is not a confirmed order.</p><button class="btn">Submit Enquiry</button></form></div><aside class="qside"><h3>What happens next</h3><ol><li>We review your requirements.</li><li>We contact you to discuss specifications and a quotation.</li><li>A physical sample is developed for your review.</li><li>Bulk production follows only after you approve the sample and agree terms.</li></ol><p class="small">Reference photos, artwork and drawings help us understand your requirement.</p></aside></div></section><%- include('partials/foot') %>
