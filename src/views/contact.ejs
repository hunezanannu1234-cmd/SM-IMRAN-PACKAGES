<%- include('partials/head') %><section class="phero"><div class="wrap"><h1>Contact us.</h1><p class="lead">Tell us about your packaging requirement, or reach us directly.</p></div></section>
<section class="sec"><div class="wrap split"><div class="details"><h3>Contact details</h3><p><%= company.phone %></p><p id="whatsapp">WhatsApp: <% if (company.hasWhatsApp) { %><a href="<%= company.whatsappLink %>">Chat now</a><% } else { %><span class="ph">[WhatsApp number - PLACEHOLDER]</span><% } %></p><p><%= company.email %></p><p><%= company.address %></p><p class="map">[Google Maps location - PLACEHOLDER]</p><p class="fine dk">Prefer to share a full requirement with dimensions and files? <a class="more" href="/quote">Request a quote</a></p></div>
<div><% if (sent) { %><p class="ok" role="status">Thank you. Your message has been received.</p><% } %>
<form method="post" action="/contact" novalidate><input type="hidden" name="_csrf" value="<%= csrf %>"><% if (errors && errors.message) { %><p class="err"><%= errors.message %></p><% } %>
<label>Name<input name="name" required maxlength="100" value="<%= form.name||'' %>"></label><label>Phone<input name="phone" maxlength="30" value="<%= form.phone||'' %>"></label><label>Email<input type="email" name="email" maxlength="150" value="<%= form.email||'' %>"></label>
<label>Message<textarea name="message" rows="6" required maxlength="3000"><%= form.message||'' %></textarea></label><button class="btn">Send Message</button></form></div></div></section><%- include('partials/foot') %>
