<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %></title><meta name="description" content="<%= desc %>"><meta name="theme-color" content="#FFFFFF">
<link rel="preload" href="/fonts/dm-serif-display-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/css/style.css?v=industry-grid"></head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header" id="top"><div class="wrap hbar"><a class="brand" href="/" aria-label="SM IMRAN PACKAGES - home"><img src="/images/logo.jpeg" alt="SM IMRAN PACKAGES logo" width="72" height="65"></a>
<nav class="nav" aria-label="Main"><% [['/','Home'],['/about','About Us'],['/products','Products'],['/custom-packaging','Custom Packaging'],['/process','Our Process'],['/gallery','Gallery'],['/contact','Contact']].forEach(l=>{ %><a href="<%= l[0] %>" <%- path===l[0]?'aria-current="page"':'' %>><%= l[1] %></a><% }) %></nav>
<div class="hcta"><a class="btn" href="/quote">Request a Quote</a></div>
<button class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mpanel"><span></span><span></span></button></div>
<div class="mpanel" id="mpanel" aria-label="Mobile menu"><nav aria-label="Mobile"><% [['/','Home'],['/about','About Us'],['/products','Products'],['/custom-packaging','Custom Packaging'],['/process','Our Process'],['/gallery','Gallery'],['/contact','Contact']].forEach(l=>{ %><a href="<%= l[0] %>" <%- path===l[0]?'aria-current="page"':'' %>><%= l[1] %></a><% }) %></nav>
<div class="mfoot"><a class="btn" href="/quote">Request a Quote</a><a class="mwa" href="<%= company.whatsappLink %>" <%- company.hasWhatsApp?'target="_blank" rel="noopener"':'' %>>Discuss on WhatsApp</a><p>Strong Carton, Trusted Quality</p></div></div></header>
<main id="main">
